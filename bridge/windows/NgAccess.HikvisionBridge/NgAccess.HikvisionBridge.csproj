<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ngsaccess-hikvision-bridge</AssemblyName>
    <RootNamespace>NgAccess.HikvisionBridge</RootNamespace>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <!-- Content öğeleri aşağıda açıkça listeleniyor; SDK'nın varsayılan appsettings.json
         include'ı ile çakışmasın (NETSDK1022). -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Scripts\*.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="hikvision-sdk\win-x64\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Gömülü ngsplus arayüzü: `npm run build` → dist → wwwroot (scripts/copy-bridge-web.mjs).
         Yoksa publish yine çalışır; "/" kökü "arayüz paketlenmemiş" uyarısı döner. -->
    <Content Include="wwwroot\**\*.*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('wwwroot')" />
  </ItemGroup>
</Project>
