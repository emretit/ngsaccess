<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../NgAccess.HikvisionBridge/Models.cs" Link="Bridge/Models.cs" />
    <Compile Include="../NgAccess.HikvisionBridge/Options.cs" Link="Bridge/Options.cs" />
    <Compile Include="../NgAccess.HikvisionBridge/Services/*.cs" Link="Bridge/Services/%(Filename)%(Extension)" />
    <Compile Include="../NgAccess.HikvisionBridge/Sdk/*.cs" Link="Bridge/Sdk/%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>
</Project>
