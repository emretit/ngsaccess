# Secure policy. Password file contains numeric UUID users + trusted bridge ONLY.
# %u is the authenticated username, never client-id or payload src-id.
# Patterns apply to every user. UUID validation and password-file generation reject
# shared/reserved device identities; no shared device account may remain deployed.
pattern read device/subscribe/%u
pattern write device/publish/%u
pattern write event/%u/access/online
pattern write event/%u/access/offline
pattern write event/%u/heartbeat
pattern write event/%u/connected
pattern write event/%u/disconnected

# Trusted infrastructure credential: never provision this account to a panel.
user bridge
topic read event/+/access/online
topic read event/+/access/offline
topic read event/+/heartbeat
topic read event/+/connected
topic read event/+/disconnected
topic read device/publish/+
topic write device/subscribe/+
topic read $SYS/#
