[Unit]
Description=NgAccess Hik gateway event subscription -> Convex /card-reader bridge
After=network-online.target DeviceGatewayService.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/ngs-hik-event-bridge/bridge.mjs
EnvironmentFile=/etc/ngs-hik-event-bridge.env
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
