+++ b/bridge/windows/NgAccess.HikvisionBridge.SelfTest/Program.cs
@@ -25,6 +25,17 @@ if (args.Contains("--audit-only"))
   return;
 }
 
+var accessStart = HikvisionClient.ValidPeriod("2026-11-01T00:00:00").struBeginTime;
+Check(accessStart is { wYear: 2026, byMonth: 11, byDay: 1, byHour: 0, byMinute: 0, bySecond: 0 }, "erişim başlangıcı kart geçerliliğine yazılır");
+var visitorStart = HikvisionClient.ValidPeriod("2026-11-01T14:30:15").struBeginTime;
+Check(visitorStart is { byHour: 14, byMinute: 30, bySecond: 15 }, "başlangıç saati korunur");
+foreach (var missing in new string?[] { null, "", "2026-11-01", "garbage" })
+{
+  var fallback = HikvisionClient.ValidPeriod(missing).struBeginTime;
+  Check(fallback.wYear == DateTime.Now.Year && fallback.byMonth == DateTime.Now.Month && fallback.byDay == DateTime.Now.Day
+    && fallback.byHour == 0, $"başlangıç yoksa bugün ({missing ?? "null"})");
+}
+
 var parser = new SseParser();
 Check(parser.ProcessLine(": ping\r") is null && parser.IsComment, "ping canlılığı");
 parser.ProcessLine("retry: 10000\r");
