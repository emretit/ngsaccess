+import { cellData, shiftTimeLabel, type Employee, type Shift, type Assignment } from '@/components/shifts/lib/planning';
+export function shiftExportRows(employees: Employee[], days: string[], assignments: Assignment[], shifts: Shift[]) {
+  return [['Çalışan', 'Sicil', ...days.map(day => `${day.slice(8, 10)}.${day.slice(5, 7)} ${new Intl.DateTimeFormat('tr-TR', { weekday: 'short', timeZone: 'Europe/Istanbul' }).format(new Date(`${day}T12:00:00Z`))}`)],
+    ...employees.map(employee => [`${employee.firstName} ${employee.lastName}`, employee.payrollCode ?? '', ...days.map(day => {
+      const records = cellData(employee, day, assignments, shifts, [], []).records;
+      return records.map(record => `${record.shift.name} · ${shiftTimeLabel(record.shift)}${record.continuation ? ' (devam)' : ''}`).join('; ') || '—';
+    })])];
+}
diff --git a/src/lib/spreadsheetExport.ts b/src/lib/spreadsheetExport.ts
new file mode 100644
index 00000000..8dad6343
--- /dev/null
+++ b/src/lib/spreadsheetExport.ts
@@ -0,0 +1,30 @@
+import { neutralizeSpreadsheetFormula } from './spreadsheetSafety';
+
+export function safeRows(rows: string[][]) {
+  return rows.map(row => row.map(neutralizeSpreadsheetFormula));
+}
+export function csvExport(rows: string[][]) {
+  return '\uFEFF' + safeRows(rows).map(row => row.map(cell => `"${cell.replace(/"/g, '""')}"`).join(';')).join('\r\n');
+}
+export function downloadExport(blob: Blob, filename: string) {
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+export async function xlsxExport(rows: string[][], sheetName: string) {
+  const { default: ExcelJS } = await import('exceljs');
+  const workbook = new ExcelJS.Workbook();
+  const sheet = workbook.addWorksheet(sheetName);
+  sheet.addRows(safeRows(rows));
+  sheet.getRow(1).font = { bold: true };
+  sheet.views = [{ state: 'frozen', xSplit: 1, ySplit: 1 }];
+  sheet.columns.forEach((column, i) => { column.width = i === 0 ? 25 : 30; });
+  const buffer = await workbook.xlsx.writeBuffer();
+  return new Blob([new Uint8Array(buffer)], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
+}
+export function exportFilenamePart(value: string) {
+  return Array.from(value, character => character.charCodeAt(0) < 32 || /[\\/:*?"<>|]/.test(character) ? '-' : character).join('');
+}
