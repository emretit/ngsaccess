@@ -0,0 +1,48 @@
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it, vi } from "vitest";
+import type { FunctionReturnType } from "convex/server";
+import type { api } from "../../../convex/_generated/api";
+import type { Id } from "../../../convex/_generated/dataModel";
+import { DeviceConnectivityHistory, connectivityDuration, connectivityTime } from "./DeviceConnectivityHistory";
+const mocks = vi.hoisted(() => ({ query: vi.fn() }));
+vi.mock("convex/react", () => ({ useQuery: mocks.query }));
+type History = FunctionReturnType<typeof api.deviceEvents.getConnectivityHistory>;
+const empty: History = { asOf: Date.parse("2026-10-22T12:00:00Z"), count: 0, totalMs: 0, longestMs: 0, periods: [], truncated: false, periodicHeartbeat: true };
+const render = (history: History | undefined) => {
+  mocks.query.mockReturnValue(history);
+  return renderToStaticMarkup(<DeviceConnectivityHistory deviceId={"device" as Id<"devices">} />);
+};
+describe("connection history section", () => {
+  it("does not show a client-side ongoing outage for card-event-only devices", () => {
+    mocks.query.mockReturnValue({ ...empty, periodicHeartbeat: false });
+    const html = renderToStaticMarkup(<DeviceConnectivityHistory deviceId={"device" as Id<"devices">} current={{ now: empty.asOf, since: empty.asOf - 3600000 }} />);
+    expect(html).not.toContain("devam ediyor");
+    expect(html).toContain("yalnız kart okutulunca sinyal gönderir");
+  });
+  it("shows the loading and empty states", () => {
+    expect(render(undefined)).toContain("Bağlantı geçmişi yükleniyor");
+    expect(render(empty)).toContain("Son 30 günde çevrimdışı dönem yok");
+    expect(mocks.query).toHaveBeenLastCalledWith(expect.anything(), { deviceId: "device" });
+  });
+  it("shows completed periods, ongoing status, limits and Istanbul times", () => {
+    const start = Date.parse("2026-10-22T09:00:00Z");
+    const html = render({ asOf: start + 8100000, count: 2, totalMs: 8100000, longestMs: 8100000, periods: [{ offlineFrom: start, offlineTo: start + 8100000, durationMs: 8100000 }], ongoing: { since: start }, truncated: true, periodicHeartbeat: true });
+    for (const text of ["Bağlantı geçmişi", "2 sa 15 dk", "22.10.2026 12:00:00", "22.10.2026 14:15:00", "devam ediyor", "son 500 dönem", "UTC+3"]) expect(html).toContain(text);
+  });
+  it("shows a newly expired signal using the existing device clock without another query", () => {
+    const now = empty.asOf;
+    mocks.query.mockReturnValue(empty);
+    const html = renderToStaticMarkup(<DeviceConnectivityHistory deviceId={"device" as Id<"devices">} current={{ now, since: now - 360000 }} />);
+    expect(html).toContain("devam ediyor");
+    expect(html).toContain("6 dk");
+    expect(html).not.toContain("Son 30 günde çevrimdışı dönem yok");
+  });
+  it("formats duration boundaries and UTC+3 across date rollover", () => {
+    expect(connectivityDuration(0)).toBe("1 dk'dan az");
+    expect(connectivityDuration(59999)).toBe("1 dk'dan az");
+    expect(connectivityDuration(60000)).toBe("1 dk");
+    expect(connectivityDuration(3600000)).toBe("1 sa");
+    expect(connectivityDuration(8100000)).toBe("2 sa 15 dk");
+    expect(connectivityTime(Date.parse("2026-10-21T22:00:00Z"))).toBe("22.10.2026 01:00:00");
+  });
+});
diff --git a/src/components/devices/DeviceConnectivityHistory.tsx b/src/components/devices/DeviceConnectivityHistory.tsx
new file mode 100644
index 00000000..6c1b2672
--- /dev/null
+++ b/src/components/devices/DeviceConnectivityHistory.tsx
@@ -0,0 +1,62 @@
+import { useQuery } from "convex/react";
+import { api } from "../../../convex/_generated/api";
+import type { Id } from "../../../convex/_generated/dataModel";
+import { Metric } from "./DeviceCenterMetric";
+
+export function connectivityDuration(ms: number): string {
+  const minutes = Math.floor(Math.max(0, ms) / 60000);
+  if (minutes === 0) return "1 dk'dan az";
+  const hours = Math.floor(minutes / 60);
+  return hours > 0 ? `${hours} sa${minutes % 60 ? ` ${minutes % 60} dk` : ""}` : `${minutes} dk`;
+}
+
+export function connectivityTime(ms: number): string {
+  return new Intl.DateTimeFormat("tr-TR", {
+    timeZone: "Europe/Istanbul", day: "2-digit", month: "2-digit", year: "numeric",
+    hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false,
+  }).format(ms);
+}
+
+export function DeviceConnectivityHistory({ deviceId, current }: {
+  deviceId: Id<"devices">;
+  current?: { now: number; since: number | undefined };
+}) {
+  const history = useQuery(api.deviceEvents.getConnectivityHistory, { deviceId });
+  // Mevcut cihaz merkezi saatini kullanır; ek timer veya sunucu polling'i yok.
+  // Kart okutunca sinyal veren cihazda (Hik gateway) sessizlik kesinti değildir: yalnız sunucunun açık dönemi.
+  const since = history?.periodicHeartbeat === false || !current ? history?.ongoing?.since : current.since;
+  const now = current?.now ?? history?.asOf ?? 0;
+  const ongoingMs = since === undefined ? 0 : Math.max(0, now - Math.max(since, now - 30 * 86400000));
+  const snapshotOngoingMs = history?.ongoing
+    ? Math.max(0, history.asOf - Math.max(history.ongoing.since, history.asOf - 30 * 86400000)) : 0;
+  const count = history ? history.count - (history.ongoing ? 1 : 0) + (since === undefined ? 0 : 1) : 0;
+  const totalMs = history ? Math.max(0, history.totalMs - snapshotOngoingMs + ongoingMs) : 0;
+  const longestMs = Math.max(history?.longestMs ?? 0, ongoingMs);
+  return (
+    <section aria-label="Bağlantı geçmişi" className="mt-5 space-y-3 border-t border-line pt-5">
+      <div>
+        <h3 className="text-base font-semibold">Bağlantı geçmişi</h3>
+        <p className="text-xs text-muted-foreground">Son 30 gün · İstanbul saati (UTC+3)</p>
+      </div>
+      {history === undefined ? <p role="status" className="text-sm">Bağlantı geçmişi yükleniyor…</p> : <>
+        <div className="grid grid-cols-3 gap-3">
+          <Metric label="Çevrimdışı sayısı" value={String(count)} />
+          <Metric label="Toplam süre" value={totalMs ? connectivityDuration(totalMs) : "0 dk"} />
+          <Metric label="En uzun süre" value={longestMs ? connectivityDuration(longestMs) : "0 dk"} />
+        </div>
+        {count === 0 && <p className="text-sm text-muted-foreground">Son 30 günde çevrimdışı dönem yok</p>}
+        {!history.periodicHeartbeat && <p className="text-xs text-muted-foreground">Bu cihaz yalnız kart okutulunca sinyal gönderir; kesinti yalnız gateway cihazı çevrimdışı bildirdiğinde kaydedilir.</p>}
+        {since !== undefined && <p className="text-sm text-warning">
+          {connectivityTime(since)} — devam ediyor
+        </p>}
+        {history.periods.length > 0 && <ol aria-label="Son çevrimdışı dönemler" className="space-y-2 text-sm">
+          {history.periods.map((period, index) => <li key={`${period.offlineTo}-${index}`} className="flex flex-wrap justify-between gap-x-3 gap-y-1">
+            <span>{connectivityTime(period.offlineFrom)} — {connectivityTime(period.offlineTo)}</span>
+            <span className="text-muted-foreground">{connectivityDuration(period.durationMs)}</span>
+          </li>)}
+        </ol>}
+        {history.truncated && <p className="text-xs text-muted-foreground">Hesaplama son 500 dönem ile sınırlı; listede son 20 tamamlanan dönem gösterilir.</p>}
+      </>}
+    </section>
+  );
+}
